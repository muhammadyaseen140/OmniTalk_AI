# Optional fallback key (users can also enter their own key in the app sidebar)
OPENAI_API_KEY=sk-your-key-here

# Where the user database is stored (default: users.db)
# AUTH_DB_PATH=users.db

# Email for "Forgot password" codes. If left empty, the app runs in demo mode
# and shows the reset code on screen instead of emailing it.
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=OmniTalk AI <you@gmail.com>
